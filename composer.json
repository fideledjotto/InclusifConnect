{
    "name": "inclusif-connect/api",
    "type": "project",
    "description": "API Laravel pour la plateforme Inclusif Connect (ressources handicap & accessibilité).",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26"
    },
    "autoload": {
        "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" }
    },
    "config": { "optimize-autoloader": true, "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
